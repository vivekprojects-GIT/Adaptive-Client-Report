ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Shared token required for /admin/*, /config/*, and /analytics/* API routes.
# Put the same value into the Admin/Analytics token prompt in the UI.
APE_ADMIN_TOKEN=replace-with-a-long-random-secret

# ---- MongoDB connection ----
# Local mongod:
#   APE_MONGO_URI=mongodb://localhost:27017
# Atlas (replace <user>, <password>, and the cluster host):
#   APE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# IMPORTANT:
#   1. URL-encode any special characters in the password (@ : / ? # %).
#   2. Never commit a real URI. .env must be in .gitignore.
#   3. Atlas: tighten Network Access to your IP/VPC; do not leave 0.0.0.0/0
#      open in production.
APE_MONGO_URI=mongodb://localhost:27017
APE_MONGO_DB=ape

# Domain tag for runtime (analytics column on every turn)
APE_DOMAIN=finance

# UCB exploration constant
APE_UCB_C=1.0

# ---- Report delivery ----
# file  = write .eml to data/generated/emails (default, nothing sent)
# gmail = Gmail API; run scripts/connect_gmail.py once first
# stub  = record the intent, send nothing
EMAIL_PROVIDER=file
EMAIL_FROM=reports@example.local

# Base URL used to build the secure report link in the email.
# Must be where THIS app is actually served.
APP_BASE_URL=http://localhost:7901

# Signs report-access tokens. Change it and every issued link stops working.
APE_REPORT_TOKEN_SECRET=change-me-to-something-long-and-random
