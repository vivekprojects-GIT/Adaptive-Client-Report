ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Shared token required for /admin/*, /config/*, and /analytics/* API routes.
# Put the same value into the Admin/Analytics token prompt in the UI.
APE_ADMIN_TOKEN=replace-with-a-long-random-secret

# ---- MongoDB connection ----
# Local mongod:
#   APE_MONGO_URI=mongodb://localhost:27017
# Atlas (replace <user>, <password>, and the cluster host):
#   APE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# IMPORTANT:
#   1. URL-encode any special characters in the password (@ : / ? # %).
#   2. Never commit a real URI. .env must be in .gitignore.
#   3. Atlas: tighten Network Access to your IP/VPC; do not leave 0.0.0.0/0
#      open in production.
APE_MONGO_URI=mongodb://localhost:27017
APE_MONGO_DB=ape

# Domain tag for runtime (analytics column on every turn)
APE_DOMAIN=finance

# UCB exploration constant
APE_UCB_C=1.0

# ---- Report delivery ----
# file  = write .eml to data/generated/emails (default, nothing sent)
# gmail = Gmail API; run scripts/connect_gmail.py once first
# stub  = record the intent, send nothing
# file | smtp | gmail | stub
#   file  — writes the .eml to data/generated/emails/, sends nothing
#   smtp  — a real send using an app password. Does NOT expire, so this is
#           the one to use for anything that must keep working.
#   gmail — Gmail API via OAuth. Convenient once, but Google expires the
#           refresh token after 7 days while the consent screen is in
#           Testing, and publishing needs a restricted-scope review.
EMAIL_PROVIDER=file

# For EMAIL_PROVIDER=smtp. Create the password at
# Google Account > Security > 2-Step Verification > App passwords.
# Never a normal account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=you@gmail.com
EMAIL_FROM=reports@example.local

# Base URL used to build the secure report link in the email.
# Must be where THIS app is actually served.
APP_BASE_URL=http://localhost:7901

# Signs report-access tokens. Change it and every issued link stops working.
APE_REPORT_TOKEN_SECRET=change-me-to-something-long-and-random

# -- Public deployment (HF Space) -----------------------------------------
# Gate for the advisor/admin surfaces. Unset = open (local dev).
ADVISOR_PASSWORD=
# Absolute base for links in emails, e.g. https://you-space.hf.space
APP_BASE_URL=
# Signs report links AND advisor session cookies. Set a long random value.
APE_REPORT_TOKEN_SECRET=
# Contents of token.json (the file itself is git-ignored). At boot it is
# written to GMAIL_TOKEN_PATH if that file is absent.
GMAIL_TOKEN_JSON=
